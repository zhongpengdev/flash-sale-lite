# ==============================================================================
# Flash Sale Lite - Environment Configuration Template
# ==============================================================================

# 应用基础配置
PROJECT_NAME="Flash Sale Lite"
ENVIRONMENT=development
DEBUG=True

# 数据库配置 (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flash_sale

# Redis 配置 (用于原子扣减、单人防刷与接口限流)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery 任务队列配置
# Celery 采用 Redis 不同的 DB 避免键冲突 (Broker 使用 db 1, Result 使用 db 2)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# 订单未支付自动超时取消时间 (秒)，默认 15 分钟 (900秒)，测试时可缩短
ORDER_EXPIRE_SECONDS=900
